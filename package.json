{
  "name": "webgl-gate",
  "version": "0.1.0",
  "description": "Skip your WebGL bundle when the page is rendered by the CPU (SwiftShader, llvmpipe, Basic Render). Under 1 kB, no network, no benchmark tables.",
  "keywords": [
    "webgl",
    "webgl2",
    "gpu",
    "gpu-detection",
    "software-rendering",
    "swiftshader",
    "llvmpipe",
    "lighthouse",
    "pagespeed",
    "core-web-vitals",
    "total-blocking-time",
    "web-performance",
    "lazy-loading",
    "pixijs",
    "threejs",
    "react-three-fiber",
    "babylonjs",
    "maplibre",
    "nextjs",
    "react",
    "vue",
    "svelte"
  ],
  "license": "MIT",
  "author": "Oleksandr Kutsenko (https://kutsikgames.com)",
  "homepage": "https://github.com/Alexkutsenko95/webgl-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexkutsenko95/webgl-gate.git"
  },
  "bugs": {
    "url": "https://github.com/Alexkutsenko95/webgl-gate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run size"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
